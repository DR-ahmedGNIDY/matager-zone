# ═══════════════════════════════════════════════════════════════
# MTAJER ZONE — Environment Variables
# Copy to .env.local for development, .env.production for production
# ═══════════════════════════════════════════════════════════════

# ── App URL ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mtajerzone.com
NEXT_PUBLIC_PLATFORM_DOMAIN=mtajerzone.com

# ── Database (MongoDB Atlas) ───────────────────────────────────
# Replace <db_password> with your actual MongoDB Atlas password
DATABASE_URL="mongodb+srv://matager2026:<db_password>@cluster0.aaf0giw.mongodb.net/mtajerzone?retryWrites=true&w=majority&appName=Cluster0"

# ── Auth.js (v5) ───────────────────────────────────────────────
# Run: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_32_CHARS"
AUTH_URL=https://mtajerzone.com

# ── Google OAuth (optional) ───────────────────────────────────
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Cloudinary (image uploads) ────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Nodemailer via SMTP) ────────────────────────────────
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@mtajerzone.com
SMTP_PASS=your-smtp-password
SMTP_FROM="متاجر زون <noreply@mtajerzone.com>"

# ── Admin WhatsApp ─────────────────────────────────────────────
# Number store owners contact for approval (E.164, digits only)
ADMIN_WHATSAPP_NUMBER=201000000000
NEXT_PUBLIC_ADMIN_WA=201000000000

# ── SEO / Analytics ───────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=your-google-verification-token
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX  # Google Analytics (optional)

# ── Redis (optional — for production rate limiting) ───────────
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Node environment ───────────────────────────────────────────
NODE_ENV=production
